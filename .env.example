# ============================================================================
# Chatimall — Backend Environment Template
# ============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file (it's in .gitignore for a reason).
#
# On Render: set these in the dashboard (Environment tab), not in this file.
# ============================================================================

# ---- Required --------------------------------------------------------------
# MongoDB Atlas connection string, or local MongoDB.
# Atlas format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Local format: mongodb://127.0.0.1:27017/chatimall
MONGODB_URI=mongodb://127.0.0.1:27017/chatimall

# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Networking ------------------------------------------------------------
PORT=4000

# Comma-separated list of allowed CORS origins.
#
# NOTE: Even if this is empty, the server ALWAYS allows requests coming from:
#   - any *.vercel.app subdomain  (so every Vercel preview deploy just works)
#   - localhost + any port        (npm run dev on any port)
#   - 127.0.0.1 + any port
# So you only NEED to fill this in for custom domains. Leave blank for dev
# and for the default chatimall-frontend.vercel.app URL.
#
# Format (examples; copy ONE line, remove the others):
#   CLIENT_ORIGINS=https://chatimall-frontend.vercel.app
#   CLIENT_ORIGINS=https://chatimall-frontend.vercel.app,https://*.vercel.app,http://localhost:5173
#   CLIENT_ORIGINS=https://app.yourdomain.com,https://chatimall-frontend.vercel.app
CLIENT_ORIGINS=https://chatimall-frontend.vercel.app,https://*.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# ---- OTP / SMS -------------------------------------------------------------
# URL + bearer token for your real SMS provider's OTP webhook (see src/sms.js).
# Leave both blank to skip real SMS during dev.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Dev-only convenience: when true, the HTTP response to request-otp INCLUDES
# the 6-digit OTP so you don't need to receive a real text. NEVER true in prod
# for a public app — use TEST_PHONES below instead.
DEV_OTP_ECHO=true

# Comma-separated `phone:code` pairs that are always accepted at login, so you
# can sign in without real SMS even in production.
# Example: TEST_PHONES=+2348012345678:123456,+15550001111:654321
TEST_PHONES=

# ---- Push notifications (optional) ----------------------------------------
# Firebase service-account JSON, on a single line. Leave empty to skip FCM.
FCM_SERVICE_ACCOUNT=

# ---- Swagger docs ----------------------------------------------------------
# Leave empty on Render (the live URL is detected automatically).
# Set PUBLIC_URL only when self-hosting behind a custom domain elsewhere.
# PUBLIC_URL=https://api.yourdomain.com
# Set DISABLE_DOCS=true to turn the Swagger page off in production.
# DISABLE_DOCS=

# ---- Voice-note translation (optional) ------------------------------------
# Base URL of the translate-service Python microservice.
# If it's not reachable, voice notes still send and play fine — just no translation.
# Leave as http://localhost:8787 for local; set your deployed URL in prod.
TRANSLATE_SERVICE_URL=http://localhost:8787
